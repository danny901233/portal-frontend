generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Garage {
  id                 String  @id @default(uuid())
  name               String
  // Set when a garage is no longer a customer. Archived garages are hidden from the garage
  // pickers and never selected for billing, but nothing is deleted — their calls, invoices and
  // documents stay intact, which matters if a billing or legal question comes up later.
  archivedAt         DateTime?
  // Explicit flag rather than guessing from the name. The billing watchdog skips these, and
  // guessing ("does the name contain 'test'?") would eventually skip a real customer called
  // something unlucky — or worse, fail to skip a test one and cry wolf every morning.
  isTestAccount      Boolean @default(false)
  // A leaving customer stays live until their notice expires, then archives itself. Relying on
  // someone remembering to archive on the day is how a former customer's calls kept being
  // answered for free — see the voice-route gate.
  archiveScheduledAt DateTime?
  // Why they left, captured when notice is given. Five garages have been archived with no record
  // of the reason, so "why did our last five customers leave" had no answer at all.
  cancellationReason      String?
  cancellationRequestedAt DateTime?
  cancellationRequestedBy String?
  // How this customer pays. 'invoice' customers (In'n'out) settle by bank transfer against an
  // emailed invoice, so their invoices sit 'pending' by design — chasing them needs payment TERMS,
  // not a failed-collection signal, and the billing watchdog must not treat them as unpaid.
  paymentMethod      String  @default("direct_debit") // 'direct_debit' | 'invoice'
  twilioNumber       String?
  hasMessagingAccess Boolean @default(false)
  hasVoiceAccess Boolean @default(true)

  // Arrears / access gating: when true, this garage's OWN users see only date+tag for
  // their calls (caller name/number, summary, transcript and recordings are withheld),
  // and per-call emails become an "account in arrears" notice. Internal staff are unaffected.
  accessRestricted   Boolean @default(false)

  // Billing Configuration
  subscriptionCostGbp Float @default(0)
  includedMinutes     Int   @default(0)
  costPerMinuteGbp    Float @default(0)
  vatRate             Float @default(0.20)

  // Webchat / Messaging Billing
  messagingSubscriptionCostGbp Float @default(0)
  // Hard ceiling on outbound WhatsApp messages per rolling 24h, deliberately below Meta's own
  // tier so we never get close to it. ReceptionMate staff only — a garage raising its own limit
  // is exactly the decision that costs them their number.
  dailyMessageLimit            Int   @default(240)
  includedMessages             Int   @default(0)
  costPerMessageGbp            Float @default(0)

  // Trial and Activation
  trialEndDate                  DateTime?
  requiresBookingActivation     Boolean   @default(false)
  bookingsRequiredForActivation Int       @default(4)
  activationBookingsCount       Int       @default(0)
  subscriptionActivatedAt       DateTime?

  // Stripe billing (NEW Assist self-serve signups only — 14-day trial then monthly card
  // subscription). Existing customers stay on GoCardless Direct Debit and never get these set.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  trialEndsAt          DateTime?
  ghlOpportunityId     String?

  // Arrears timer: set when a Stripe card charge fails. Once this is older than the grace
  // period (2 days) the garage is auto-locked (accessRestricted = true). Cleared when a
  // payment succeeds. Only ever set for Stripe customers (GoCardless billing is separate).
  paymentFailedAt      DateTime?

  // Setup Wizard
  setupWizardCompleted   Boolean   @default(false)
  setupWizardCompletedAt DateTime?
  // Set when the welcome email actually goes out. Column already exists in the database; it was
  // missing from this schema copy, so the client could not see it. Doubles as the
  // "self-serve trial already activated" marker for assistTrialActivation.
  welcomeEmailSentAt     DateTime?

  // Widget Customization
  widgetLogoUrl      String?
  widgetLogoWidth    Int     @default(120)
  widgetLogoHeight   Int     @default(60)
  widgetPrimaryColor String?
  widgetButtonColor  String?
  widgetButtonShape  String  @default("circle")
  widgetButtonIcon   String  @default("chat")

  calls                  Call[]
  // Outbound caller ID. These columns have been live in the database for a while but were never
  // added here, so every reference to them in outbound-calls.ts was a type error and the backend
  // could not build.
  outboundCallerId         String?
  outboundCallerIdVerified Boolean  @default(false)
  outboundCallerIdSid      String?
  outboundCalls            OutboundCall[]
  agentConfiguration     AgentConfiguration?
  agentConfigChanges     AgentConfigChange[]
  knowledgeDocuments     AgentKnowledgeDocument[]
  business               Business?                @relation(fields: [businessId], references: [id])
  businessId             String?
  conversations          ChatConversation[]
  socialMediaConnections SocialMediaConnection[]
  customers              Customer[]
  smsBookingLinks        SmsBookingLink[]
  invoices               Invoice[]
  messageTemplates       MessageTemplate[]
  outboundCampaigns      OutboundCampaign[]
  garageHiveConnection   GarageHiveConnection?
}

// Per-garage Garage Hive (Business Central) integration + daily reminder config.
// Each Garage Hive account is its own BC environment (tenantId + environmentName);
// branches are companies (companyId). The Azure AD app clientId/secret are shared
// across accounts via env once each account grants the app access, but can be
// overridden here per garage if needed.
model GarageHiveConnection {
  id                 String    @id @default(cuid())
  garageId           String    @unique
  garage             Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  tenantId           String
  environmentName    String
  companyId          String
  clientId           String? // optional per-garage app creds; else shared env app
  clientSecret       String?
  remindersEnabled   Boolean   @default(false)
  reminderDaysAhead  Int       @default(30)
  reminderTemplateId String? // approved WhatsApp MessageTemplate id used for auto-sends
  reminderChannel    String    @default("whatsapp") // "whatsapp" | "sms"
  // Caller recognition — on an inbound call, look the caller's number up in the
  // Garage Hive phonebook so the agent confirms their vehicle instead of asking
  // for the reg. Off by default; GarageHive-agent only.
  callerRecognitionEnabled Boolean @default(false)
  // Advisory upsells — when a customer books over the phone, the voice agent
  // checks their vehicle for outstanding health-check advisories (recommended
  // work not yet booked) and offers to add them. GarageHive-agent only.
  advisoryUpsellsEnabled Boolean @default(false)
  lastRunAt          DateTime?
  lastRunError       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Call {
  id                       String                    @id @default(cuid())
  garageId                 String
  garage                   Garage                    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  roomName                 String
  recordingUrl             String?
  recordingDurationSeconds Int?
  recordingCompletedAt     DateTime?
  twilioCallSid            String?
  fromNumber               String?
  durationSeconds          Int                       @default(0)
  callType                 String                    @default("unknown")
  registrationNumber       String?
  customerName             String?
  customerPhone            String?
  confirmedBooking         Boolean                   @default(false)
  confirmedBookingCategory ConfirmedBookingCategory?
  capturedRevenue          Float?
  bookingDetails           String?
  metrics                  Json
  transcript               Json
  summary                  String
  emotionData              Json?
  createdAt                DateTime                  @default(now())
  feedback                 CallFeedback?
}

model TwilioRecording {
  id                       String    @id @default(cuid())
  callSid                  String    @unique
  recordingSid             String?
  recordingUrl             String
  recordingDurationSeconds Int?
  completedAt              DateTime?
  roomName                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  mustChangePassword    Boolean   @default(false)
  mustSetupPayment      Boolean   @default(false)
  gocardlessMandateId   String?
  gocardlessCustomerId  String?
  billingCycleStartDate DateTime?
  nextBillingDate       DateTime?
  garageAccessIds       String[]  @default([])
  // Where ops alerts go for this person. Deliberately separate from `email` (the login): Gab is a
  // VA on a personal Gmail, and alerts must reach him without that address becoming an account.
  // Alerts sent here carry a title and a link only — never customer details. See opsNotify.ts.
  notificationEmail     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  role                  UserRole  @default(USER)
  branchRoles           Json      @default("{}")
  resetToken            String?
  resetTokenExpiry      DateTime?

  // Hard account lock. Set by staff (suspected fraud, abuse, a signup we don't want live). While
  // lockedAt is set the user cannot log in, cannot request or use a password reset, and cannot
  // use a magic link — every auth path returns "contact us" rather than a credentials error.
  //
  // Deliberately on User, not Garage: garage.accessRestricted is the ARREARS mechanism and by
  // design still lets people sign in to pay. A lock has to stop sign-in itself, and resetting a
  // password must not route around it.
  lockedAt              DateTime?
  lockedReason          String?

  // Onboarding tracking
  setupWizardCompleted   Boolean   @default(false)
  setupWizardCompletedAt DateTime?

  // Service agreement
  mustSignAgreement Boolean     @default(true)

  // Session control & audit.
  // sessionsValidFrom invalidates every JWT issued before it — the only way to log someone out
  // when tokens are stateless. Bump it and their existing sessions stop working.
  sessionsValidFrom DateTime?
  lastLoginAt       DateTime?
  loginEvents       LoginEvent[]
  agreements        Agreement[]

  // Magic-link tokens for "sign your agreement" links (short-lived, single-use)
  signLinkTokens SignLinkToken[]

  // In-portal support chat with the ReceptionMate team
  supportConversation SupportConversation?
  supportMessages     SupportMessage[]

  // Ops-tasks board (staff-only) — a staff user may be the assignee or the creator
  opsTasksAssigned OpsTask[] @relation("OpsTaskAssignee")
  opsTasksCreated  OpsTask[] @relation("OpsTaskCreatedBy")

  // Garage-side Messages inbox: a garage's team member can own conversations
  // from their garage's customers. Assignment is per-garage — a multi-branch
  // user only sees/owns conversations on their allowed garages. Assignment
  // is ownership only; it does NOT silence the AI (that's a separate action).
  assignedChatConversations ChatConversation[] @relation("ChatConversationAssignee")

  // Mobile push notifications (iOS APNs device tokens). One user may have
  // several devices; tokens are registered by the mobile app on launch.
  deviceTokens String[] @default([])
  pushEnabled  Boolean  @default(true)
}

// Lightweight inbound-support chat between a portal user (the customer) and
// the ReceptionMate team. One thread per user — keeps the team's view simple
// and avoids fragmenting context across multiple "tickets".
model SupportConversation {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'ai' (AI is handling) | 'awaiting_staff' (escalated, staff hasn't replied) |
  // 'staff_handled' (a staff member has replied) | 'closed'
  status          String           @default("ai")
  aiTurns         Int              @default(0)
  // Cached for the admin inbox so we don't have to fan out joins for every row
  lastMessageAt   DateTime         @default(now())
  lastMessageText String?
  // Unread counters — incremented on inbound, reset by the relevant side
  unreadForUser   Int              @default(0)
  unreadForStaff  Int              @default(0)
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        SupportMessage[]

  @@index([lastMessageAt])
  @@index([status])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Sender — `senderUserId` set when a real human sent it (could be the
  // customer User or an RM staff User). `senderRole` distinguishes who sent it
  // so the UI can render bubbles correctly regardless of who the User is.
  senderRole     String // 'customer' | 'staff' | 'system'
  senderUserId   String?
  sender         User?               @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  channel        String              @default("portal") // 'portal' | 'whatsapp' | 'slack' (future)
  body           String              @db.Text
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

// SaaS service agreement — one per business; staff issues a draft with commercial
// terms, customer signs in the portal. Snapshot of the rendered HTML is stored so
// updates to the template don't change what a customer has already signed.
model Agreement {
  id      String @id @default(cuid())
  type    String // 'saas' (today) or 'partnership' (future)
  version String // template version, e.g. '1.0'
  status  String @default("draft") // 'draft' | 'sent' | 'signed' | 'externally_signed' | 'voided'

  // Who it's for
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  // Commercial terms (the placeholders from the PDF)
  clientName    String // matches the business name at the time of issue
  setupFeeGbp   Float     @default(0)
  licenceFeeGbp Float // £ per centre per month
  centresCount  Int       @default(1)
  licences      String[]  @default(["assist"]) // any of: assist, automate, connect
  goLiveDate    DateTime?

  // Rendered content snapshot — the exact HTML they saw at sign time
  templateSnapshot String @db.Text

  // Signature audit
  signedAt        DateTime?
  signedByName    String?
  signedByEmail   String?
  signedFromIp    String?
  signedUserAgent String?
  // Drawn-signature PNG as base64 data URL — embedded into templateSnapshot
  signatureImage  String?   @db.Text

  // Generated PDF copy
  pdfUrl String?

  // External signature (for High Level legacy customers)
  externallySignedAt   DateTime?
  externalSignatureRef String? // free text — e.g. High Level envelope ID

  // Admin metadata
  issuedByUserId String? // staff who created the draft
  voidedAt       DateTime?
  voidedReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([businessId])
  @@index([status])
}

// Short-lived single-use tokens for "sign your agreement" email links.
// Used so customers in the sales-led flow can land directly on /agreement/sign
// without having to log in first.
model SignLinkToken {
  id          String    @id @default(cuid())
  token       String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreementId String?
  purpose     String    @default("sign_agreement") // 'sign_agreement' for now
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AgentConfiguration {
  id                        String   @id @default(cuid())
  garageId                  String   @unique
  garage                    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  branchName                String
  agentName                 String?
  phoneNumber               String?
  emailAddress              String?
  branchAddress             String?
  websiteUrl                String?
  weeklyOpeningHours        Json?
  holidayClosures           String?
  greetingLine              String?
  tonePreference            String   @default("standard")
  responseSpeed             String   @default("normal")
  interruptionSensitivity   Float    @default(0.5)
  allowFastFitOnly          Boolean  @default(false)
  // Garage Hive voice-agent booking behaviours (only for the GarageHive/automate agent)
  callerRecognitionEnabled  Boolean  @default(false)
  advisoryUpsellsEnabled    Boolean  @default(false)
  enableDropOffBookings     Boolean  @default(false)
  dropOffMessage            String   @default("drop your vehicle off between 8am and half ten in the morning")
  dropOffExcludeServices    String[] @default(["MOT"])
  notificationEmails        String[] @default([])
  integrationProvider       String   @default("none")
  integrationProviderConfig Json?
  agentType                 String   @default("assist")
  agentScript               String   @default("receptionmate-agent")
  enableSmsBookingLinks     Boolean  @default(true)
  humanEscalation           Boolean  @default(true)
  transferNumber            String?
  // Messaging (chat) human handoff — independent of the voice humanEscalation above.
  // true  = the chat agent offers to take a message / flag the team when a human is asked for.
  // false = the chat agent politely declines and points them at phone/email (messagingHandoffMessage).
  messagingHumanHandoff     Boolean  @default(true)
  messagingHandoffMessage   String?
  // Messaging notifications: when to alert the garage and how.
  messagingNotifyScope      String   @default("off")
  messagingNotifyEmail      Boolean  @default(false)
  messagingNotifySms        Boolean  @default(false)
  messagingNotifyPhone      String?
  allowBookings             Boolean  @default(false)
  bookingLeadTimeDays       Int      @default(1)
  // What kind of motor business this is, in the words the voice agent uses to introduce itself.
  // Most garages are repair-only, which is what the agent assumed for everyone until Kestrels --
  // a used car dealer AND a workshop -- told a caller it does not sell cars. Populated from the
  // Google Places `types` at signup where we have them, editable in the portal either way.
  businessType              String?
  customRules               Json?
  dataCollectionFields      Json?
  faqs                      Json?
  pronunciations            Json?
  voice                     String   @default("leah")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model AgentKnowledgeDocument {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  source    String
  title     String?
  url       String?
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, source])
  @@index([garageId])
}

model CallFeedback {
  id        String   @id @default(cuid())
  callId    String   @unique
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  rating    String
  reasons   String[] @default([])
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmsBookingLink {
  id               String   @id @default(cuid())
  garageId         String
  garage           Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  phoneNumber      String
  twilioMessageSid String?
  status           String   @default("sent")
  costGbp          Float    @default(0.99)
  createdAt        DateTime @default(now())

  @@index([garageId, createdAt])
  @@index([garageId])
}

// One row per messaging-notification SMS actually sent, for billing (£0.20 each).
model MessagingNotificationSms {
  id               String   @id @default(cuid())
  garageId         String
  phoneNumber      String
  twilioMessageSid String?
  costGbp          Float    @default(0.20)
  createdAt        DateTime @default(now())

  @@index([garageId, createdAt])
  @@index([garageId])
}

model Business {
  id           String      @id @default(cuid())
  name         String
  agreements   Agreement[]
  contactName  String?
  contactEmail String?
  contactPhone String?
  contactRole  String?
  garages      Garage[]
  billingMethod String @default("directdebit") // 'directdebit' | 'stripe_card' | 'invoice'

  // Billing Information
  billingAddress       String?
  billingCity          String?
  billingPostcode      String?
  billingCountry       String?   @default("United Kingdom")
  vatNumber            String?
  companyRegNumber     String?
  billingEmail         String?
  billingInfoUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              String             @id @default(cuid())
  garageId        String
  garage          Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  name            String?
  phone           String?
  email           String?
  whatsappId      String?
  facebookUserId  String?
  instagramUserId String?
  notes           String?
  metadata        Json?
  conversations   ChatConversation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([garageId])
  @@index([garageId, phone])
  @@index([garageId, email])
}

model ChatConversation {
  id                       String                    @id @default(cuid())
  garageId                 String
  garage                   Garage                    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  customerId               String?
  customer                 Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  platform                 String
  customerPhone            String?
  platformUserId           String?
  customerName             String?
  status                   String                    @default("active")
  agentPaused              Boolean                   @default(false)
  agentPausedUntil         DateTime?
  pausedByUserId           String?
  pausedByUserEmail        String?
  needsAttention           Boolean                   @default(false)
  messageType              String?
  confirmedBooking         Boolean                   @default(false)
  confirmedBookingCategory ConfirmedBookingCategory?
  capturedRevenue          Float?
  bookingDetails           String?
  tags                     String[]                  @default([])
  // Auto-derived enquiry category for garage-side Messages inbox filters.
  // App-code enum: parts | sales | booking | complaint | general. Nullable
  // so historical rows and cases we can't classify remain untouched.
  enquiryType              String?
  // Optional owner within the garage. FK to User; onDelete SetNull so a
  // staff member losing garage access drops their conversations back into
  // the shared "unassigned" pool rather than orphaning them.
  assigneeId               String?
  assignee                 User?                     @relation("ChatConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  unreadCount              Int                       @default(0)
  lastMessageAt            DateTime                  @default(now())
  sessionState             Json?
  messages                 ChatMessage[]
  toolCalls                ChatToolCall[]
  feedback                 ChatFeedback?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([garageId, status])
  @@index([garageId, platform])
  @@index([garageId, customerId])
  @@index([garageId, needsAttention])
  @@index([garageId, assigneeId])
  @@index([garageId, enquiryType])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  mediaUrl       String?
  mediaType      String?
  metaMid        String?          @unique
  staffUserId    String?
  staffUserEmail String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// Observability for the web-chat agents: one row per tool call the agent makes.
// Written fire-and-forget from the agent tool loop (chatAgentAssist/V2/Tyresoft).
// Powers the per-conversation tool timeline and the staff success-rate dashboard.
model ChatToolCall {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  garageId       String
  agentType      String // assist | automate | tyresoft
  toolName       String
  args           Json?
  result         Json?
  success        Boolean
  errorMessage   String?
  durationMs     Int?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([garageId, createdAt])
  @@index([toolName, success])
}

// Garage-side rating of an AI conversation. Mirrors CallFeedback exactly so
// the weekly negative-feedback audit process (Monday SOP) can classify calls
// and messages with the same buckets. One row per conversation — upsert on
// re-rating. rating is 'up' | 'down' in app code; reasons are free-form now
// but constrained to a small fixed set in the UI (wrong_info, ghost_booking,
// complaint_mishandled, tone, handover_failed, other).
model ChatFeedback {
  id             String           @id @default(cuid())
  conversationId String           @unique
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  rating         String
  reasons        String[]         @default([])
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model SocialMediaConnection {
  id                    String   @id @default(cuid())
  garageId              String
  garage                Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  platform              String
  whatsappPhoneNumberId String?
  pageId                String?
  instagramAccountId    String?
  accountName           String?
  accessToken           String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([garageId, platform])
  @@index([garageId])
}

model MessageTemplate {
  id       String @id @default(cuid())
  garageId String
  garage   Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  name     String // Template name (lowercase, underscores only)
  category String // UTILITY, MARKETING, AUTHENTICATION
  language String @default("en_GB")

  // Template content
  headerType      String? // none, text, image, document
  headerContent   String? // Header text or media URL
  headerSample    String? // Sample value for {{1}} in header
  bodyText        String // Main message body with {{1}}, {{2}} variables
  variableSamples Json? // Sample values for variables e.g. {"{{1}}":"John","{{2}}":"15th March"}
  footerText      String? // Optional footer
  buttonType      String? // none, url, call, quick_reply
  buttonText      String? // Button label
  buttonValue     String? // URL or phone number

  // Meta status
  metaTemplateId  String? // Template ID returned by Meta after submission
  status          String  @default("draft") // draft, pending, approved, rejected
  rejectionReason String? // Reason if rejected by Meta

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, name])
  @@index([garageId])
  @@index([garageId, status])
}

enum UserRole {
  MANAGER
  USER
  RECEPTIONMATE_STAFF
}

enum ConfirmedBookingCategory {
  service
  diagnostic
  mot
  other
}

model OutboundCampaign {
  id                String            @id @default(cuid())
  garageId          String
  garage            Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  name              String
  channel           String            @default("sms") // "sms" | "whatsapp"
  status            String            @default("draft") // "draft" | "sending" | "sent" | "processed" | "failed" | "queued"
  sentAt            DateTime?
  resumeAt          DateTime?
  tierLimit         Int               @default(250)
  totalContacts     Int               @default(0)
  sentCount         Int               @default(0)
  messageTemplateId String? // Optional: ID of MessageTemplate to use
  variableMapping   Json? // e.g. {"1": "customer_name", "2": "mot_due_date"}

  // How this campaign is delivered. Not everything outbound is a due-date reminder — an offer
  // or an announcement goes out ONCE, and chasing someone three times about a promotion is how
  // you lose a WhatsApp number.
  //   "oneoff"   — send to everyone now, no follow-ups (offers, announcements). The default,
  //                so any campaign created before this existed keeps its old behaviour.
  //   "reminder" — due-date driven: each contact is messaged at their own point before their
  //                MOT/service is due, using reminderStages below.
  // Set when Meta tells us this traffic looks like spam (error 131048) or blocks the number for
  // a policy violation (368). Sending stops immediately and stays stopped for the whole garage
  // for 24h — the failure mode we are guarding against is a garage re-running the same list
  // minutes later, which is what preceded a WABA being permanently disabled in July.
  haltedAt          DateTime?
  haltReason        String?
  campaignType      String            @default("oneoff") // "oneoff" | "reminder"
  // Days-before-due at which to message, largest first. Only read when campaignType=reminder,
  // and per-campaign so a garage can run a single 14-day nudge without touching the others.
  reminderStages    Int[]             @default([30, 14, 3])

  contacts          OutboundContact[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([garageId])
}

model OutboundContact {
  id             String           @id @default(cuid())
  campaignId     String
  campaign       OutboundCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  garageId       String
  customerName   String
  phone          String
  registration   String?
  motDueDate     String?
  serviceDueDate String?
  // Parsed from motDueDate/serviceDueDate at upload. Those stay as the raw strings the DMS
  // exported; this is the machine-readable version the reminder scheduler works from. Null
  // means we could not read the date and the row is skipped rather than guessed at — sending
  // someone a reminder on the wrong day is worse than not sending one.
  dueDate        DateTime?
  // Which reminder stages have gone out, in days-before-due (e.g. [30, 14]). Lets a garage
  // upload overlapping windows without anyone being messaged the same stage twice.
  stagesSent     Int[]            @default([])
  messageType    String           @default("mot") // "mot" | "service"
  // "booked" = the customer told us they're already booked, so the remaining stages are skipped.
  status         String           @default("pending") // "pending" | "sent" | "replied" | "booked" | "opted_out" | "failed" | "expired"
  messageSid     String?
  errorReason    String?
  conversationId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([campaignId])
  @@index([garageId, phone])
  // The scheduler's daily sweep: "pending contacts with a due date, per garage".
  @@index([garageId, status, dueDate])
}

model Invoice {
  id         String  @id @default(cuid())
  garageId   String
  garage     Garage  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  businessId String?
  userId     String? // User who should be charged for this invoice

  // Billing Period
  periodStart DateTime
  periodEnd   DateTime

  // Usage
  minutesUsed            Int @default(0)
  minutesIncluded        Int @default(0)
  smsCount               Int @default(0)
  notificationSmsCount   Int @default(0) // Messaging-notification SMS sent (£0.20 each)
  messagingMessagesCount Int @default(0) // Webchat/messaging messages billed

  // Costs (in pence for precision)
  subscriptionAmount          Int // Base (voice) subscription cost
  minutesAmount               Int @default(0)
  smsAmount                   Int @default(0)
  notificationSmsAmount       Int @default(0) // Messaging-notification SMS cost (£0.20 each)
  messagingSubscriptionAmount Int @default(0) // Webchat subscription portion
  messagingMessagesAmount     Int @default(0) // Webchat overage messages cost
  subtotal                    Int // Before VAT
  vatAmount                   Int // VAT only
  total                       Int // Final amount

  // Rates used (stored for audit trail)
  subscriptionCostGbp Float
  costPerMinuteGbp    Float
  vatRate             Float

  // Status
  status String @default("draft") // draft, pending, paid, failed, cancelled

  // GoCardless
  gocardlessPaymentId  String?
  gocardlessChargeDate DateTime?
  // When payment is due (issue date + the customer's terms, currently 14 days). Without this
  // stored, nothing could answer "what is overdue" — the due date was only ever calculated inside
  // the In'n'out email template and printed, never kept.
  dueDate              DateTime?
  chaseSentAt          DateTime? // first reminder, on the due date
  chase2SentAt         DateTime? // second reminder, 14 days later
  paidAt               DateTime?

  // Credit/Void tracking
  creditReason String?
  creditedAt   DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, periodStart])
  @@index([businessId, periodStart])
  @@index([status])
}

// A self-serve Assist signup that has NOT yet become a real account. Created when the
// customer submits their garage details; the real Business/Garage/User/Agreement are
// only created once they have signed the agreement AND confirmed a card (Stripe
// setup_intent.succeeded). Until then we hold their details here and track them in
// HighLevel's "Abandoned checkout" stage so no interested party is lost.
model PendingSignup {
  id            String   @id @default(uuid())
  businessName  String
  email         String
  name          String?
  googlePlaceId String?
  product      String?  // assist | automate | connect | multibranch | custom
  contactPhone String?  // contact phone captured on the scope step (non-Assist)
  gclid        String?  // Google Ads click id, carried from the marketing site — proves which signups came from an ad
  // Which page the signup started on. A cross-origin POST sends only the origin as
  // Referer, so without this a signup cannot be attributed to a landing page at all.
  source       String?

  // Enriched from Google Places at submit time so we don't re-call Google on completion.
  branchAddress      String?
  phoneNumber        String?
  websiteUrl         String?
  weeklyOpeningHours Json?
  // Carried from the Google Places lookup so the agent knows whether this is a repair garage,
  // a dealership, or both, from the very first call rather than after someone complains.
  businessType       String?

  // Magic-link sign token (single-use-ish; the pending row is the source of truth).
  signToken String  @unique
  status    String  @default("pending") // pending | signed | completed

  // HighLevel — opportunity starts in "Abandoned checkout", moves to "Free trial live" on completion.
  ghlOpportunityId String?
  ghlContactId     String?

  // Signature capture (transferred onto the real Agreement on completion).
  signedByName     String?
  signedByPosition String?
  signatureImage   String?  @db.Text
  signedFromIp     String?
  signedUserAgent  String?
  templateSnapshot String?  @db.Text
  agreementVersion String?
  signedAt         DateTime?

  // Stripe trial — created when they sign; the webhook maps the confirmed card back here.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  trialEndsAt          DateTime?

  // Set once the real account is provisioned (idempotency guard for the webhook).
  createdGarageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([email])
  @@index([stripeCustomerId])
}

// Ops-tasks board — shared internal task list for RM staff (Dan + the VA).
// Postgres-backed so both staff see the same list; mirrors the SupportConversation
// pattern for auth + shape. Managed by /admin/tasks and /api/admin/tasks/*.
model OpsTask {
  id           String    @id @default(cuid())
  title        String
  instructions String?   @db.Text
  cadence      String    @default("weekly") // 'daily' | 'weekly' | 'monthly' | 'project'
  tags         String[]  @default([])
  status       String    @default("open") // 'open' | 'done'
  notes        String?   @db.Text
  // Who the task belongs to. assigneeIds is the source of truth and supports more than one
  // person ("Both" on the board); assigneeId mirrors its first entry so the assignee relation —
  // and anything still reading a single id — keeps working.
  assigneeIds  String[]  @default([])
  priority     String    @default("normal") // 'normal' | 'urgent'
  assigneeId   String?
  assignee     User?     @relation("OpsTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?     @relation("OpsTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  // For weekly tasks: which day of the week to do it on (visual hint only,
  // does NOT affect reset/report logic — the weekly reset still runs every Monday).
  // Null = no preferred day. Only meaningful when cadence='weekly'.
  weeklyDay    String?   // 'mon' | 'tue' | 'wed' | 'thu' | 'fri' | 'sat' | 'sun'
  sortOrder    Int       @default(0)
  completedAt  DateTime?
  completedById String?  // who ticked it off — plain id, resolved against staff for display
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cadence, status])
  @@index([assigneeId])
}

/// Immutable log of every completion.
///
/// OpsTask.completedAt cannot be the history: "reset daily" flips every daily task back to open
/// and clears it, so yesterday's work would erase itself each morning. Titles are snapshotted
/// because tasks get renamed and deleted, and a past report must still read true.
model OpsTaskCompletion {
  id            String   @id @default(cuid())
  taskId        String?
  taskTitle     String
  cadence       String
  tags          String[] @default([])
  completedById String?
  completedAt   DateTime @default(now())
  notes         String?  @db.Text // notes as they stood when it was ticked off

  @@index([completedAt])
  @@index([taskId])
}

/// One row per day, written by the 21:00 cron and then never changed — so a report stays true to
/// the day even after tasks are edited, reassigned or deleted.
model OpsDailyReport {
  id          String    @id @default(cuid())
  reportDate  String    @unique // 'YYYY-MM-DD', Europe/London
  completed   Json      @default("[]")
  outstanding Json      @default("[]")
  notes       Json      @default("[]")
  totals      Json      @default("{}")
  emailedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([reportDate])
}


// Who signed in, when, and from where. There was previously no record of a login at all, so
// "who was in the portal on Tuesday" had no answer. Failures are recorded too — a run of them
// against one account is worth seeing.
// What changed in a garage's agent settings, who changed it, and what it was before.
//
// Settings have "reverted" before with no way to tell whether a person did it, a bad save
// dropped them, or the config sync overwrote them -- the validator strip in August wiped FAQs to
// an empty list and nobody could prove what had happened. One row per save, holding only the
// fields that actually differed.
model AgentConfigChange {
  id        String   @id @default(cuid())
  // What kind of change this row describes: 'agent_config' for the agent's settings, 'garage' for
  // commercial ones — price, tier, access, trial dates. Same table because the question people
  // actually ask is "what changed on this garage and who did it", and splitting that across two
  // places just means checking two places.
  scope     String   @default("agent_config")
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  userId    String?
  userEmail String?
  // [{ field, from, to }] — values are truncated, this is for answering "who turned that off",
  // not for restoring a backup.
  changes   Json
  createdAt DateTime @default(now())

  @@index([garageId, createdAt])
  @@index([createdAt])
}

// Outbound calls placed from the portal. Table has existed in the database since the outbound
// feature shipped; the model was never written, so the route that uses it could not compile.
model OutboundCall {
  id              String   @id @default(cuid())
  garageId        String
  garage          Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  toNumber        String
  callerId        String
  agentPhone      String
  twilioCallSid   String?
  status          String   @default("initiated")
  durationSeconds Int?
  createdAt       DateTime @default(now())

  @@index([garageId, createdAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean  @default(true)
  reason    String?  // why a failure was rejected: 'bad_password' | 'no_user' | 'revoked'
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([email])
}
